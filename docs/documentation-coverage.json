    "redis_constructors": {
      "src/empire/plugins/collection/control.py": {
        "f'{store.prefix}:collection:control:v1'": [
          "collection-control"
        ]
      },
      "src/empire/plugins/collection/record_query.py": {
        "f'{records.redis.prefix}:collection:{kind}:'": [
          "archives",
          "archives-revision",
          "errors",
          "errors-revision"
        ]
      },
      "src/empire/plugins/collection/records.py": {
        "f'{self.redis.prefix}:collection:{kind}:'": [
          "archives",
          "archives-revision",
          "errors",
          "errors-revision"
        ],
        "f'{self.redis.prefix}:collection:{kind}:{project_id}'": [
          "archives",
          "archives-revision",
          "errors",
          "errors-revision"
        ]
      },
      "src/empire/features/capital_actions/query.py": {
        "f'{store.prefix}:checkpoint:{self.job_key}'": [
          "checkpoint"
        ]
      },
      "src/empire/features/financial_statements/query.py": {
        "f'{store.prefix}:collection:control:v1'": [
          "collection-control"
        ]
      },
      "src/empire/features/preparation/cache.py": {
        "f'{store.prefix}:preparation:report:{digest}'": [
          "preparation-report"
        ]
      },
      "src/empire/features/stocks/dataset.py": {
        "f'{prefix}:stocks:committed:{source}'": [
          "stocks-committed"
        ],
        "f'{prefix}:stocks:result:{source}'": [
          "stocks-result"
        ]
      },
      "src/empire/plugins/infra/collection_state.py": {
        "f'{redis.prefix}:archive:progress:{job_key}'": [
          "archive-progress"
        ]
      },
      "src/empire/plugins/infra/proxy_pool.py": {
        "'router:proxies:by-code'": [
          "router-mapping"
        ],
        "'router:proxies:device'": [
          "router-directory"
        ]
      },
      "src/empire/plugins/infra/redis_store.py": {
        "f'{self.prefix}:ingest'": [
          "ingest"
        ]
      },
      "src/empire/plugins/infra/routing.py": {
        "f'{key}:proxy:{route}'": [
          "rate-proxy"
        ],
        "f'{service.prefix}:rate:{group.name}'": [
          "rate-site"
        ],
        "key + ':total'": [
          "rate-total"
        ]
      },
      "src/empire/plugins/pipeline/archive.py": {
        "f\"{self.redis.prefix}:checkpoint:{first['envelope'].job_key}\"": [
          "checkpoint"
        ],
        "f'{self.redis.prefix}:archive:progress:{envelope.job_key}'": [
          "archive-progress"
        ]
      },
      "src/empire/plugins/pipeline/fingerprints.py": {
        "f'{self.store.prefix}:archive:fingerprints:v1:{namespace}:{source}'": [
          "fingerprints"
        ],
        "key + ':expiry'": [
          "fingerprint-expiry"
        ]
      },
      "src/empire/plugins/pipeline/ingest.py": {
        "f'{self.redis.prefix}:checkpoint:{job_key}'": [
          "checkpoint"
        ]
      },
      "src/empire/diagnostics/redis_evidence.py": {
        "f'{self.prefix}:collection:control:v1'": [
          "collection-control"
        ],
        "f'{self.prefix}:checkpoint:{job}'": [
          "checkpoint"
        ],
        "f'{self.prefix}:archive:progress:{job}'": [
          "archive-progress"
        ],
        "f'{self.prefix}:ingest'": [
          "ingest"
        ]
      },
      "src/empire/features/stocks/confirmation.py": {
        "f'{redis.prefix}:stocks:committed:{source}'": [
          "stocks-committed"
        ],
        "f'{redis.prefix}:stocks:result:{source}'": [
          "stocks-result"
        ]
      }
    }
